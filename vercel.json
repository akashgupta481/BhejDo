{
  "git": {
    "deploymentEnabled": false
  },
  "github": {
    "silent": true
  },
  "ignoreCommand": "bash vercel-ignore-build.sh",
  "buildCommand": "cd frontend && npm ci && npm run build && cd .. && cp -r frontend/dist ./dist",
  "outputDirectory": "dist",
  "installCommand": "echo 'Dependencies installed in buildCommand'",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
